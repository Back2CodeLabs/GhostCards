# Copier ce fichier en ".env" et remplir les valeurs.

# URL Pronote de l'établissement (visible dans la barre d'adresse en se connectant
# depuis un navigateur, se termine par /pronote/eleve.html)
PRONOTE_URL=https://0000000a.index-education.net/pronote/eleve.html

# Chemins (les valeurs par défaut conviennent pour un déploiement simple sur l'OptiPlex)
# CREDENTIALS_PATH=./secrets/credentials.json
# DATA_DIR=./data
# DB_PATH=./data/ghostcards.db

# Fréquence de récupération de l'emploi du temps
# SYNC_DAYS_BACK=3
# SYNC_DAYS_FORWARD=10

# Clé API Anthropic (pour l'assistant IA), créée sur
# https://console.anthropic.com/settings/keys — laisser vide désactive
# l'assistant proprement (erreur claire plutôt qu'un plantage).
# ANTHROPIC_API_KEY=sk-ant-...

# Authentification élève (pairage Pronote) — voir Services/README.md,
# section "Authentification élève (pairage Pronote)", pour le détail complet.
# SESSION_SECRET_KEY=          # génère avec: python3 -c "import secrets; print(secrets.token_hex(32))"
# CREDENTIALS_ENCRYPTION_KEY=  # génère avec: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Classe attendue au pairage (vide = pas de vérification de classe) :
# CLASSE_ATTENDUE=2F

# Authentification admin (Cédric) — totalement séparée des comptes élèves,
# un élève ne peut jamais devenir admin. Laisser vide désactive la
# connexion admin. Génère un mot de passe avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# ADMIN_PASSWORD=
